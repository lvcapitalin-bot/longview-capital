# =========================================================================
# Longview Capital - Production Environment Variables
# =========================================================================

# Primary production domain
NEXT_PUBLIC_SITE_URL=https://www.lvcapital.in

# 1. Google Sheets Auto-Save Webhook (Recommended)
# Automatically appends every investor enquiry as a new row in your Google Sheet
# Created via Google Sheets > Extensions > Apps Script > Deploy as Web App
GOOGLE_SHEETS_WEBHOOK_URL=

# 2. Instant Lead Notifications (Optional - Telegram Bot)
# To receive instant lead alerts directly on Sunny & Harsh's phones via Telegram:
# 1. Message @BotFather on Telegram to create a bot and get your BOT_TOKEN
# 2. Add your bot to a private channel or message it to get your CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3. Email Lead Forwarding (Optional)
CONTACT_RECEIVER_EMAIL=lvcapital.in@gmail.com
